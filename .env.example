# The app reads process environment variables; it does not load this file.
# Default: version-controlled JSON, no writable web directory needed.
CONTENT_STORE=files
# To enable SQLite, import content then set CONTENT_STORE=database.
# DB_DSN=sqlite:/srv/jsd-technologies/var/content.sqlite
# Optional MariaDB (create a database and a dedicated user first):
# DB_DSN=mysql:host=localhost;dbname=jsd_technologies;charset=utf8mb4
# DB_USER=site_reader
# DB_PASSWORD=configure-outside-repository
